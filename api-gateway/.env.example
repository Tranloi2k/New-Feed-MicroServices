# API Gateway Environment Variables

PORT=8080
NODE_ENV=development

# Set to the exact number of trusted reverse proxies in front of the gateway.
# Keep 0 when clients connect directly (such as the default Docker Compose setup).
TRUST_PROXY_HOPS=0

# JWT Secret (must match auth service)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ISSUER=newfeed-auth-service
JWT_AUDIENCE=newfeed-api-gateway

# Service Secret for inter-service communication
SERVICE_SECRET=your-service-to-service-secret-key-change-this

# Microservices URLs
AUTH_SERVICE_URL=http://auth-service:3001
POST_SERVICE_URL=http://post-service:3002
MEDIA_SERVICE_URL=http://media-service:3003
COMMENT_SERVICE_URL=http://comment-service:3004
NOTIFICATION_SERVICE_URL=http://notification-service:3005

# CORS
CLIENT_URL=http://localhost:3000

# Redis Configuration (for rate limiting)
REDIS_URL=redis://redis:6379

# Logging
LOG_LEVEL=info
