# Comment Service Environment Variables

PORT=3004
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@postgres-comment:5432/comment_db

# Service Secret for inter-service communication
SERVICE_SECRET=your-service-to-service-secret-key-change-this

# RabbitMQ (for event consumption)
RABBITMQ_URL=amqp://admin:admin@rabbitmq:5672

# Auth Service (for user lookup)
AUTH_SERVICE_URL=http://auth-service:3001

# Post Service (for post ownership validation)
POST_SERVICE_URL=http://post-service:3002

# CORS
CLIENT_URL=http://localhost:3000

# Redis cache and GraphQL PubSub
REDIS_URL=redis://redis:6379
