# Global Environment Variables (for Docker Compose)

# Required immutable GHCR tag. Use the full commit SHA produced by CI.
IMAGE_TAG=0123456789abcdef0123456789abcdef01234567

# JWT & Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
SERVICE_SECRET=your-service-to-service-secret-key-change-this

# Database URLs (Docker Compose will use these)
AUTH_DB_URL=postgresql://postgres:postgres@postgres-auth:5432/auth_db
POST_DB_URL=postgresql://postgres:postgres@postgres-post:5432/post_db
COMMENT_DB_URL=postgresql://postgres:postgres@postgres-comment:5432/comment_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_URL=amqp://admin:admin@rabbitmq:5672

# Cloudinary (Media Upload Service)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# Node Environment
NODE_ENV=development

# Demo login: blank enables it only outside production; set false to disable.
DEMO_LOGIN_ENABLED=
DEMO_USER_EMAIL=demo@newfeed.local
DEMO_USER_PASSWORD=Demo123!
DEMO_USER_USERNAME=demo
DEMO_USER_FULL_NAME=Demo User
