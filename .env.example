# Docker Compose environment
# Copy to .env. Do not commit real secrets.

# Immutable GHCR tag produced by CI.
IMAGE_TAG=0123456789abcdef0123456789abcdef01234567
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Shared security configuration. Use distinct random values in production.
JWT_SECRET=replace-me-with-at-least-32-random-characters
JWT_ISSUER=newfeed-auth-service
JWT_AUDIENCE=newfeed-api-gateway
SERVICE_SECRET=replace-me-with-a-different-32-character-random-value

# Auth service
BCRYPT_ROUNDS=10
AUTH_COOKIE_DOMAIN=
REFRESH_TOKEN_RETENTION_DAYS=30

# Gateway runtime
TRUST_PROXY_HOPS=0
LOG_LEVEL=info

# Shared infrastructure credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=replace-me

# Media service
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

# Push notifications (Android/FCM). Contents of the Firebase service account
# JSON, on one line. Leave empty to disable push; the service still runs.
FIREBASE_SERVICE_ACCOUNT=
