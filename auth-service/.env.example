# Auth Service Environment Variables

PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@postgres-auth:5432/auth_db

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Service Secret for inter-service communication
SERVICE_SECRET=your-service-to-service-secret-key-change-this

# CORS
CLIENT_URL=http://localhost:3000

# Bcrypt Salt Rounds
BCRYPT_ROUNDS=10

# Development demo login (disabled by default when NODE_ENV=production)
DEMO_LOGIN_ENABLED=true
DEMO_USER_EMAIL=demo@newfeed.local
DEMO_USER_PASSWORD=Demo123!
DEMO_USER_USERNAME=demo
DEMO_USER_FULL_NAME=Demo User
