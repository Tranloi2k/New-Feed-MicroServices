# Auth Service Environment Variables

PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@postgres-auth:5432/auth_db

# Access JWT is fixed at 30 minutes. Refresh token lifetime is 30 days.
JWT_SECRET=replace-me
JWT_ISSUER=newfeed-auth-service
JWT_AUDIENCE=newfeed-api-gateway

# Service Secret for inter-service communication
SERVICE_SECRET=replace-me

# CORS
CLIENT_URL=http://localhost:3000

# Production only when FE and API are sibling subdomains, e.g. .example.com.
AUTH_COOKIE_DOMAIN=

# Bcrypt Salt Rounds
BCRYPT_ROUNDS=10

# Retention period for revoked refresh tokens, used by sessions:cleanup.
REFRESH_TOKEN_RETENTION_DAYS=30

# Redis cache
REDIS_URL=redis://redis:6379
